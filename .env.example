# Gastroenterology St Vincent's Hospital Melbourne - Email & API Configuration

# Gmail Sender Account (Must be gastroenterologystvincents@gmail.com)
GMAIL_USER=gastroenterologystvincents@gmail.com

# Gmail 16-character App Password (Generated in Google Account > Security > 2-Step Verification > App passwords)
# Paste your generated password here (keep this in .env, never commit real password):
GMAIL_APP_PASSWORD=your_app_password_here

# SMTP Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Notification Routing Addresses
COORDINATOR_EMAIL=anne.savage@svha.org.au
ENDOSCOPY_WAITINGLIST_EMAIL=Endoscopy Waitinglist - SVHM <Endoscopy.Waitinglist@svhm.org.au>
CLINIC_COORDINATION_EMAIL=gastroenterology.caseco-ordinationteam <gastroenterology.cas@svha.org.au>
